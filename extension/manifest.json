{
  "manifest_version": 3,
  "name": "GoApply by Foligo",
  "version": "1.3.0",
  "description": "One-click job applications. AI cover letters. Kanban tracking. Powered by Foligo.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "debugger",
    "scripting",
    "sidePanel",
    "tabs",
    "tabGroups",
    "alarms",
    "notifications",
    "downloads"
  ],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GoApply by Foligo"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "commands": {
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Open the GoApply AI side panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "core/api.js",
        "core/detector.js",
        "core/finder.js",
        "core/filler.js",
        "core/tracker.js",
        "core/agent-controller.js",
        "core/boards.js",
        "core/banners.js",
        "core/consent.js",
        "core/tutorial.js",
        "core/ui.js",
        "core/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://foligo.tech/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content_script/foligo-auth.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config/remoteConfig.json", "preview.html"],
      "matches": ["*://*/*"]
    }
  ]
}
