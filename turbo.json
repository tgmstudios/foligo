{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "sites/components/BuilderCanvas.vue",
    "sites/utils/builder*.mjs",
    "sites/components/SitesMarkdown.vue",
    "sites/utils/site-markdown*.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**"],
      "cache": true
    },
    "foligo-api#build": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true
    }
  }
}
