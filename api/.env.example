# Environment Configuration Template
# Copy this file to .env and update the values

# Application
NODE_ENV=development
PORT=80

# Public sign-ups (email/password registration)
# Set to 'false' to disable — SSO/OAuth sign-ups are unaffected.
ALLOW_PUBLIC_SIGNUPS=true

# Database
DATABASE_URL="postgresql://username:***@localhost:5432/foligo_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# API Documentation
API_DOCS_PATH="/api-docs"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3001"

# Production domains
API_DOMAIN="api.foligo.tech"
FRONTEND_DOMAIN="foligo.tech"

# ═══════════════════════════════════════════════════════════════════
# AI Provider Configuration (model-agnostic)
# ═══════════════════════════════════════════════════════════════════

# Default AI provider: gemini | openai | opencode | ollama | anthropic | custom
AI_DEFAULT_PROVIDER=gemini

# Fallback chain — tried in order if the default is unhealthy
AI_FALLBACK_CHAIN=gemini,opencode

# ─── Gemini ───────────────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key          # (legacy env var — still supported)
AI_GEMINI_API_KEY=your-gemini-api-key
AI_GEMINI_MODEL=gemini-flash-latest
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com  # custom endpoint

# ─── OpenCode Go ──────────────────────────────────────────────────
# OpenCode runs locally via `opencode serve` exposing OpenAI-compatible API
AI_OPENCODE_ENDPOINT=http://127.0.0.1:8080/v1
AI_OPENCODE_API_KEY=opencode                 # default: "opencode"
AI_OPENCODE_MODEL=opencode-go

# ─── OpenAI ───────────────────────────────────────────────────────
# AI_OPENAI_API_KEY=sk-...
# AI_OPENAI_ENDPOINT=https://api.openai.com/v1
# AI_OPENAI_MODEL=gpt-4o-mini

# ─── Ollama ───────────────────────────────────────────────────────
# AI_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1
# AI_OLLAMA_API_KEY=ollama
# AI_OLLAMA_MODEL=llama3.1

# ─── Anthropic Claude ─────────────────────────────────────────────
# AI_ANTHROPIC_API_KEY=sk-ant-...
# AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AI_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Custom (any OpenAI-compatible endpoint) ──────────────────────
# AI_CUSTOM_ENDPOINT=http://127.0.0.1:8080/v1
# AI_CUSTOM_API_KEY=your-key
# AI_CUSTOM_MODEL=default
# AI_CUSTOM_HEADERS={"X-Custom-Header":"value"}

# ─── ElevenLabs (voice) ───────────────────────────────────────────
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_AGENT_ID=agent_1301k8emq0nzfwmbyta7254adhpv

# ─── MinIO (Media Storage) ────────────────────────────────────────
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=foligo
# MINIO_PUBLIC_URL=http://localhost:9000/foligo

# API URL (for generating proxied media URLs)
# API_URL=http://localhost:3000
